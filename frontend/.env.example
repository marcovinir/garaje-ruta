# URL de Django para el rewrite de /api/v1 (en Vercel: la URL del proyecto backend).
BACKEND_URL=http://localhost:8000

# URL pública del sitio (Open Graph, sitemap y enlaces de WhatsApp).
SITIO_URL=http://localhost:3000

# Secretos compartidos con Django (iguales a los de backend/.env; vacíos en local).
SERVIDOR_NEXT_SECRETO=
REVALIDACION_SECRETO=

# Nube de Cloudinary (vacía = fotos con marcador gris).
NEXT_PUBLIC_CLOUDINARY_CLOUD=

# Ruta pública del panel (en producción, algo no obvio; igual a PANEL_RUTA de Django).
NEXT_PUBLIC_PANEL_RUTA=/panel
