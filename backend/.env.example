# Copia este archivo como backend/.env (solo hace falta si corres Django fuera de Docker).
# Con Docker Compose, el backend recibe DATABASE_URL desde docker-compose.yml.
# El Postgres de Docker usa el puerto 5433 para no chocar con un PostgreSQL local en el 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/garaje_ruta
SECRET_KEY=cambia-esto-en-local
FRONTEND_URL=http://localhost:3000
# Ruta del panel, igual a NEXT_PUBLIC_PANEL_RUTA del frontend (en producción, algo no obvio).
PANEL_RUTA=/panel
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Claves de los usuarios de ejemplo (manage.py sembrar).
# SEMILLA_PASSWORD: admin y colaborador; secreta y obligatoria fuera de desarrollo.
# SEMILLA_PASSWORD_DEMO: usuario demo de solo lectura; es pública (README).
SEMILLA_PASSWORD=Local-Garaje-2026
SEMILLA_PASSWORD_DEMO=Demo-Garaje-2026

# Fotos: cloudinary://<api_key>:<api_secret>@<cloud_name> (Cloudinary → API Keys)
CLOUDINARY_URL=

# Secreto compartido con Next para /api/revalidar (vacío en local).
REVALIDACION_SECRETO=

# Secreto que Next envía en X-Servidor-Next al pedir datos desde su servidor.
SERVIDOR_NEXT_SECRETO=

# Producción: API key de Resend (SMTP) y remitente verificado.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Garaje Ruta <garaje@marcovinir.dev>

# Producción: saltos de proxy delante de Django (Vercel = 1) para el límite del login.
NUM_PROXIES=1

# Solo para E2E sin Cloudinary: apps.articulos.fotos.AlmacenFotosMemoria
# ALMACEN_FOTOS=
